@model IEnumerable<TheCoffeeHouse.Models.EtityFarmwork.Product>
@{
    ViewBag.Title = "Coffee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" id="content">
    <div class="row">
        <h3 id="cf">@ViewBag.CoffeePartial</h3>
        @foreach (var item in Model)
        {
            <div id="item-product" class="col-lg-3 col-md-6 col-6">
                <a href="@Url.Action("ProductDetail","Menu", new { id = item.ProductID, cateid = item.CateID })"><img src="~/Content/Clients/assets/img-Product/@item.Image" alt=""></a>
                <h4><a href="@Url.Action("ProductDetail","Menu", new { id = item.ProductID, cateid = item.CateID })">@item.Name</a></h4>
                <p>@item.Price vnd</p>
            </div>
        }
    </div>
</div>

