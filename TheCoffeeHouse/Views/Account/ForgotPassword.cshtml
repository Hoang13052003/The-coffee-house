@model TheCoffeeHouse.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên Mật Khẩu";

    Layout = "~/Views/Shared/_Layout.cshtml";
}


<main class="container form-forgot-password">
    <div class="forgot-password-box">
        <h2>@ViewBag.Title</h2>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            <p class="text-danger">@Html.ValidationSummary("", new { @class = "text-danger" })</p>

            <div class="form-group">
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Nhập tên đăng nhập" })
            </div>

            <button type="submit" class="btn btn-primary w-100">Lấy lại mật khẩu</button>
        }
    </div>
</main>


@section Styles {
    <style>
        .form-forgot-password {
            margin-top: 30px;
            justify-content: center;
            align-items: center;
            height: 60vh;
        }

        .forgot-password-box {
            background: #ffffff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 10px;
        }

            .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
            }

        .btn-primary {
            background-color: #007bff;
            border: none;
            padding: 10px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
        }

            .btn-primary:hover {
                background-color: #0056b3;
            }
    </style>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
