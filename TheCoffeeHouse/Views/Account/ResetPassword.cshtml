@model TheCoffeeHouse.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
}

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 450px; width: 100%;">
        <div class="card-body">
            <h3 class="text-center text-dark fw-bold">🔒 Đặt lại mật khẩu</h3>
            <p class="text-center text-muted">Nhập thông tin để đặt lại mật khẩu.</p>
            <hr />

            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @*@Html.ValidationSummary("", new { @class = "alert alert-danger" })*@
                @Html.HiddenFor(model => model.Code)

                <div class="mb-3">
                    <label class="form-label fw-bold">📧 Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Nhập email" })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">🔑 Mật khẩu mới</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu mới" })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">🔁 Xác nhận mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-check-circle"></i></span>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary fw-bold">
                        🔄 Đặt lại mật khẩu
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}