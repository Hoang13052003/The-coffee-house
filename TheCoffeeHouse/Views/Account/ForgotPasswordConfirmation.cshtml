@{
    ViewBag.Title = "Thay đổi mật khẩu";
}

<main aria-labelledby="title" style="margin: 50px auto; height: 700px">
    <div class="container">
        <hgroup class="title text-center">
            <h1 id="title">@ViewBag.Title</h1>
        </hgroup>
        <p class="text-center" >
            Chúng tôi đã gửi email xác thực đến cho bạn. Vui lòng kiểm tra email và đổi mật khẩu!
        </p>
    </div>
</main>
