@model TheCoffeeHouse.Models.EtityFarmwork.Slider
@using TheCoffeeHouse.Models.ViewModel
@{
    ViewBag.Title = "Cập nhật danh mục Slider";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Home" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/AdvertisementSlider" class="nav-link">Slider</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a class="nav-link">Edit</a>
        </li>
    </ul>
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Cập nhật Slider</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Trang chủ</li>
                    <li class="breadcrumb-item active">Slider</li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>
<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Thông tin Cập nhật</h3>

        </div>
        <div class="card-body">
            <div class="bs-stepper-content">
                <!-- your steps content here -->

                @using (Html.BeginForm("Edit", "AdvertisementSlider", FormMethod.Post, new { }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    @Html.HiddenFor(x => x.ID)
                    <div class="form-group">
                        <label for="">Tên danh mục</label>
                        @Html.TextBoxFor(x => x.Name, new { @class = "form-control", @PlaceHolder = "Tên danh mục" })
                        @Html.ValidationMessageFor(x => x.Name, null, new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label for="">Ảnh slider</label>
                        @Html.TextBoxFor(x => x.Image, new { @class = "form-control", @PlaceHolder = "Ảnh slider", type = "file" })
                        @Html.ValidationMessageFor(x => x.Image, null, new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label for="">Link</label>
                        @Html.TextBoxFor(x => x.Link, new { @class = "form-control", @PlaceHolder = "Đường dẩn đến trang" })
                        @Html.ValidationMessageFor(x => x.Link, null, new { @class = "text-danger" })
                    </div>
                    <div id="information-part" class="content" role="tabpanel" aria-labelledby="information-part-trigger">
                        <a href="/Admin/AdvertisementSlider" class="btn btn-danger">Quay lại</a>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
