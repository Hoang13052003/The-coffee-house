@model TheCoffeeHouse.Models.EtityFarmwork.Sale

@{
    ViewBag.Title = "Thêm mới Sale";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Home" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Sale" class="nav-link">Sale</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="#" class="nav-link">Add</a>
        </li>
    </ul>
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Thêm mới Sale</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Trang chủ</li>
                    <li class="breadcrumb-item active">Sale</li>
                    <li class="breadcrumb-item active">Add</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>
<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Thông tin thêm mới</h3>

        </div>
        <div class="card-body">
            <div class="bs-stepper-content">
                <!-- your steps content here -->

                @using (Html.BeginForm("Add", "Sale", FormMethod.Post, new { }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)

                <div id="logins-part" class="content active dstepper-block" role="tabpanel" aria-labelledby="logins-part-trigger">
                    <div class="form-group">
                        <label for="">Tên Sale</label>
                        @Html.TextBoxFor(x => x.Name, new { @class = "form-control", @PlaceHolder = "Tên Sale" })
                        @Html.ValidationMessageFor(x => x.Name, null, new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label for="">SeoTitle</label>
                        @Html.TextBoxFor(x => x.SeoTitle, new { @class = "form-control", @PlaceHolder = "SeoTitle" })
                        @Html.ValidationMessageFor(x => x.SeoTitle, null, new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label for="">Ảnh Sale</label>
                        @Html.TextBoxFor(x => x.Image, new { @class = "form-control", @PlaceHolder = "Ảnh Sale", type = "file" })
                        @Html.ValidationMessageFor(x => x.Image, null, new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label for="">Description</label>
                        @Html.TextBoxFor(x => x.Description, new { @class = "form-control", @PlaceHolder = "Mô tả" })
                        @Html.ValidationMessageFor(x => x.Description, null, new { @class = "text-danger" })
                    </div>
                </div>
                    <div id="information-part" class="content" role="tabpanel" aria-labelledby="information-part-trigger">
                        <a href="/Admin/Sale" class="btn btn-danger">Quay lại</a>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>